# Local development only. Copy to `.env` to override.
# This file is committed so the env contract is in the repo; it never
# contains real credentials.
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
DATABASE_URL=postgresql://gloss_dev:local_dev_only@127.0.0.1:55434/gloss_dev
BETTER_AUTH_URL=http://127.0.0.1:8080
# Leave empty to use the in-process development secret. Production refuses
# the development placeholder, so a deployment must set a real value here.
BETTER_AUTH_SECRET=
SERVER_LOG_LEVEL=info

# Comma-separated origins that are allowed to call the auth endpoints, in
# addition to BETTER_AUTH_URL and its loopback alias. Phase 2 rejects any
# value that is not on loopback; configure a public origin only when this
# build is no longer phase 2.
TRUSTED_ORIGINS=

# Comma-separated emails granted the `admin` role on startup. Idempotent:
# restarting the server never changes an existing administrator. Never
# revokes: remove an address here only stops future grants.
ADMIN_EMAILS=

# Auth rate limiter. By default the limiter is on only in production, so
# local development and the test suite do not interfere with each other.
# Set AUTH_RATE_LIMIT_ENABLED=1 to force it on.
AUTH_RATE_LIMIT_ENABLED=
AUTH_RATE_LIMIT_WINDOW=10
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_LOGIN_WINDOW=10
AUTH_RATE_LIMIT_LOGIN_MAX=3
AUTH_RATE_LIMIT_MAIL_WINDOW=60
AUTH_RATE_LIMIT_MAIL_MAX=3

# ── 邮件发送（验证邮箱 / 重置密码）─────────────────────────────────────────
# outbox = 进程内开发收件箱，只在 development/test 允许；邮件链接可通过
#          GET /api/dev/mail/latest?to=<邮箱> 读回，也可看终端日志。
# smtp   = 真实 SMTP 发送。不设置时：development/test 用 outbox，
#          production 必须为 smtp，否则服务拒绝启动（不会假装发过邮件）。
# 阿里云邮件推送（DirectMail）接入步骤见 docs/邮件服务配置-阿里云.md。
MAIL_TRANSPORT=

# 阿里云邮件推送（华东 1 杭州）：smtpdm.aliyun.com
SMTP_HOST=
# 留空时按 SMTP_SECURITY 取默认端口：ssl=465，starttls=587，none=25。
# 阿里云邮件推送支持 25 / 80 / 465（SSL）；STARTTLS 用 25 或 80。
SMTP_PORT=
# ssl = 465 隐式 TLS（推荐）；starttls = 升级 TLS（阿里云用 80 或 25）；
# none = 明文，仅本地假服务器可用，production 会拒绝启动。
SMTP_SECURITY=ssl
# 阿里云邮件推送：SMTP_USER 为完整发信地址，SMTP_PASS 为控制台设置的 SMTP 密码。
SMTP_USER=
SMTP_PASS=
# login = AUTH LOGIN；none = 无认证（仅本地假服务器，production 拒绝）。
SMTP_AUTH=login
# 发信地址，必须是已在阿里云验证的发信地址（与 SMTP_USER 一致）。
SMTP_FROM=
SMTP_FROM_NAME=KoBook
# 连接/握手/命令超时，单位毫秒，范围 1000–120000。
SMTP_TIMEOUT_MS=15000

# ── 手机号验证码（注册 / 登录 / 重置密码）──────────────────────────────────
# outbox = 进程内开发短信收件箱，只在 development/test 允许；验证码可通过
#          GET /api/dev/sms/latest?to=%2B86<手机号> 读回，development 也会打印到终端。
# aliyun = 真实短信发送。不设置时：development/test 用 outbox，production 必须
#          显式配置 aliyun，否则服务拒绝启动（不会假装发过短信）。
# 阿里云短信接入步骤见 docs/短信验证码-阿里云.md。
SMS_TRANSPORT=
# 阿里云短信控制台：RAM 子账号 AccessKey、已审核通过的签名与模板（模板变量必须是 code）。
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_REGION=cn-hangzhou
# 验证码与手机号摘要的 HMAC 密钥，至少 32 字节。production 必须设置；
# development/test 留空会用明确标注的虚拟占位值。
PHONE_OTP_SECRET=
# 可选：验证码有效期（默认 300000 ms）与单个验证码可试错次数（默认 5）。
PHONE_OTP_TTL_MS=
PHONE_OTP_MAX_ATTEMPTS=
# 可选：同一号码发送预算（默认 1 次 / 60 秒，另有每小时 5 次上限）。
PHONE_OTP_SEND_PHONE_LIMIT=
PHONE_OTP_SEND_PHONE_WINDOW_MS=
# 可选：同一来源（服务端解析的连接地址）发送预算（默认 10 次 / 60 秒，另有每小时 50 次上限）。
PHONE_OTP_SEND_CLIENT_LIMIT=
PHONE_OTP_SEND_CLIENT_WINDOW_MS=

# Never put platform keys in VITE_* variables: they become public browser code.
# The following legacy names are intentionally unsupported. Do not add values;
# browser configuration belongs in the local Settings panel and is never part
# of the environment contract or cloud/export payload.
# VITE_OPENAI_API_KEY=
# VITE_OPENAI_BASE_URL=
# VITE_MODEL=

# Phase 3 slice 2 reads these to call r.jina.ai for URL imports.
# Leave empty in slice 1: the URL route is mounted but the body schema
# rejects `kind: "url"`, so the import page only accepts text in the
# meantime. Once a real key is set, slice 2 enables the URL path
# without any frontend change.
JINA_API_KEY=
# Override r.jina.ai for the integration test (points at a local fake
# that mimics the Jina envelope shape). Leave empty in production.
JINA_BASE_URL=


# ── 网页抓取的出口代理 ─────────────────────────────────────────────────────
# 留空 = 直连。设置了就把"直连失败的跳"重试一次经过这个代理：
# 服务器仍先做固定 IP 直连（SSRF 钉住），只有网络层失败才走代理。
# 用代理时 DNS 由代理解析，地址钉住不再成立——这是有意的取舍，所以它
# 只从环境读，且只在直连失败后启用。TLS 仍按目标域名校验。
# 例：http://127.0.0.1:6789
EXTRACT_PROXY_URL=
