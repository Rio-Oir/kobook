{
  "name": "kobook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MPL-2.0",
  "description": "A local-first Chinese reader: import links and documents, read, highlight, ask your own model, and optionally sync across devices. No billing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rio-Oir/kobook.git"
  },
  "homepage": "https://github.com/Rio-Oir/kobook#readme",
  "bugs": {
    "url": "https://github.com/Rio-Oir/kobook/issues"
  },
  "scripts": {
    "pdfjs:assets": "node scripts/pdfjs-assets.mjs",
    "predev": "npm run pdfjs:assets",
    "dev": "vite",
    "prebuild": "npm run pdfjs:assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck:frontend": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "typecheck:base-tests": "tsc -p apps/reader-release/tsconfig.base-tests.json --noEmit",
    "pretypecheck": "prisma generate",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:server && npm run typecheck:tests",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:unit:byok": "node --import tsx --test \"tests/unit/byok-*.test.ts\"",
    "test:browser:byok": "node tests/byok-browser.mjs",
    "test": "npm run typecheck && npm run test:unit",
    "acceptance:base": "node apps/reader-release/acceptance-base.mjs",
    "prebuild:release": "npm run pdfjs:assets",
    "build:release": "node apps/reader-release/build.mjs",
    "prisma:generate": "prisma generate",
    "build:server": "prisma generate && tsc -p server/tsconfig.json && node server/scripts/emit-esm-extensions.mjs",
    "start:server": "node server/dist/server/src/index.js",
    "test:server-artifact": "node tests/server/artifact-smoke.mjs",
    "dev:server": "node scripts/server.mjs",
    "dev:all": "node scripts/dev.mjs",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:bootstrap": "node scripts/db.mjs bootstrap",
    "caddy:setup": "node scripts/caddy.mjs setup",
    "test:phase1": "node --import tsx tests/phase1.ts",
    "test:phase2": "node --import tsx tests/phase2.ts",
    "test:phase3": "node --import tsx tests/phase3.ts",
    "test:integration": "npm run test:phase1 && npm run test:phase2 && npm run test:phase3",
    "test:browser:notes": "node tests/browser-note-lifecycle.mjs",
    "test:browser:notebook": "node tests/browser-notebook.mjs",
    "test:browser:reading": "node tests/reading-layout-browser.mjs",
    "test:browser:auth": "node tests/browser-auth.mjs",
    "test:browser:articles": "node tests/browser-articles.mjs",
    "pretest:phase1": "node scripts/db.mjs bootstrap",
    "pretest:phase2": "node scripts/db.mjs bootstrap",
    "pretest:phase3": "node scripts/db.mjs bootstrap",
    "pretest:browser:auth": "node scripts/db.mjs bootstrap",
    "pretest:browser:articles": "node scripts/db.mjs bootstrap",
    "pretest:browser:byok": "node scripts/db.mjs bootstrap",
    "verify": "node scripts/verify.mjs",
    "preverify": "node scripts/db.mjs bootstrap",
    "admin": "node scripts/admin.mjs",
    "mail:check": "node --import tsx scripts/mail-check.mjs",
    "sms:check": "node --import tsx scripts/sms-check.mjs",
    "browser:install": "playwright install chromium",
    "notices": "node scripts/third-party-notices.mjs",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "tls:fixture": "node scripts/tls-fixture.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.58",
    "@mozilla/readability": "0.6.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-blockquote": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-bullet-list": "^3.32.0",
    "@tiptap/extension-code": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-horizontal-rule": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list-item": "^3.32.0",
    "@tiptap/extension-ordered-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-strike": "^3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-table-cell": "3.32.0",
    "@tiptap/extension-table-header": "3.32.0",
    "@tiptap/extension-table-row": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "ai": "5.0.273",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "5.12.5",
    "jsdom": "29.0.0",
    "linkedom": "0.18.14",
    "lucide-react": "^1.60.0",
    "mdast-util-to-string": "4.0.0",
    "motion": "^14.4.0",
    "nanoid": "5.1.16",
    "nodemailer": "10.1.7",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tailwind-merge": "^3.7.0",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/jsdom": "30.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "3.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "dotenv": "17.4.2",
    "fake-indexeddb": "^6.2.6",
    "pino-pretty": "13.2.0",
    "playwright": "1.64.0",
    "postcss": "8.5.29",
    "prisma": "7.10.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "engines": {
    "node": "24.12.0",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "undici": "6.29.0"
  }
}
